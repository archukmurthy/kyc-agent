{
  "name": "kyc-onboarding-agent",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@anthropic-ai/sdk": "^0.102.0",
    "@complycube/api": "^1.1.14",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.8.0",
    "@vercel/kv": "^3.0.0",
    "dompurify": "^3.4.14",
    "formidable": "^3.5.4",
    "ioredis": "^5.11.0",
    "playwright": "^1.61.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "xlsx": "^0.18.5"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build && node scripts/stage-validation-lab.js",
    "test": "react-scripts test",
    "test:smoke:db": "node scripts/real-db-smoke.js",
    "idv:test": "node --test idv/__tests__/providerContract.nodetest.js idv/__tests__/lifecycle.nodetest.js idv/__tests__/securityAndRouting.nodetest.js idv/__tests__/failureModes.nodetest.js idv/__tests__/secureIdentity.nodetest.js idv/__tests__/metrics.nodetest.js idv/__tests__/productionGuards.nodetest.js",
    "idv:security-scan": "node idv/scripts/securityScan.js",
    "idv:migrate": "node idv/persistence/applyModuleSchema.js",
    "idv:db:migrate": "node -r dotenv/config db/apply-idv.js dotenv_config_path=.env.local",
    "idv:db:seed": "node -r dotenv/config scripts/demo/seed-complete.js dotenv_config_path=.env.local",
    "idv:db:seed:populated": "node -r dotenv/config scripts/demo/seed-populated.js dotenv_config_path=.env.local",
    "idv:harness": "node idv/harness/server.js",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "vercel": "^52.2.1"
  }
}
