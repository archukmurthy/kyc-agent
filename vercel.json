{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "framework": "create-react-app",
  "functions": {
    "api/doc-search.js": { "maxDuration": 60 },
    "api/self-source.js": { "maxDuration": 60 },
    "api/generate-policy.js": { "maxDuration": 300 },
    "api/finalize-submissions.js": { "maxDuration": 60 },
    "api/purge-trial-data.js": { "maxDuration": 300 }
  },
  "crons": [
    { "path": "/api/finalize-submissions", "schedule": "* * * * *" },
    { "path": "/api/purge-trial-data", "schedule": "0 3 * * *" }
  ],
  "routes": [
    { "src": "/api/evidence(/.*)?", "status": 404 },
    { "src": "/evidence-lab.*", "status": 404 }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/super-admin/(.*)", "destination": "/index.html" },
    { "source": "/super-admin", "destination": "/index.html" },
    { "source": "/admin/(.*)", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/preview", "destination": "/index.html" },
    { "source": "/preboarding", "destination": "/index.html" },
    { "source": "/preboarding/(.*)", "destination": "/index.html" },
    { "source": "/ubo-trials", "destination": "/index.html" },
    { "source": "/ubo-trials/(.*)", "destination": "/index.html" },
    { "source": "/policy-simulator", "destination": "/index.html" },
    { "source": "/policy-simulator/(.*)", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
