# Copy this file to .env.local and fill in real values for local dev.
# Configure production values in Vercel only for the capabilities being deployed.

# Anthropic API key — used by api/research.js to proxy KYC research requests.
ANTHROPIC_API_KEY=sk-ant-...

# Optional Evidence Lab A3 semantic interpretation model. Both this and the
# Anthropic key above are required only for LIVE preserved-Artifact interpretation.
EVIDENCE_A3_ANTHROPIC_MODEL=claude-sonnet-4-5

# Admin password — fallback for the Nium tenant on /admin (and only Nium).
# All other tenants have per-tenant passwords managed by /super-admin and
# stored hashed in KV under tenant-auth:{tenantId}.
ADMIN_PASSWORD=nium-admin-2026

# Super admin password — gates the /super-admin tenant-management UI.
# Internal Nium use only; never given to clients.
SUPER_ADMIN_PASSWORD=nium-super-2026

# Pre-boarding (analyst) access password — checked server-side by
# /api/preboarding-auth. Shared across tenants for now; per-tenant analyst
# passwords are tracked as backlog PREB-3.
PREBOARDING_PASSWORD=change-me-preboarding

# TENANT_ID is no longer used — tenant resolution is 3-strict (?tenant= or the
# x-tenant-id header). Set nothing here; a request without a tenant is refused.

# Vercel KV (or any Upstash Redis with the Vercel KV REST API) — when these
# are present the config API uses KV for storage and version snapshots.
# Without them the config API falls back to filesystem storage
# (./.config-store.json in dev, /tmp/config-store.json on Vercel).
KV_REST_API_URL=your_vercel_kv_url_here
KV_REST_API_TOKEN=your_vercel_kv_token_here

# Signs customer dossier link tokens (/?tenant=<id>&dossierToken=<token>).
# Required for invites and for customers opening their link. Use a long random
# value (e.g. `openssl rand -base64 48`). Rotating it invalidates every link.
DOSSIER_TOKEN_SECRET=change-me-to-a-long-random-value

# Signs the one-time research grants the search counters hand out, which
# /api/research requires from link customers (optional). Falls back to
# DOSSIER_TOKEN_SECRET when unset; with neither, customer re-searches are refused.
# RESEARCH_GRANT_SECRET=change-me-to-another-long-random-value

# Per-caller hourly limits on the endpoints that spend Claude tokens (optional).
# Callers are bucketed by verified pre-boarding analyst tenant, customer link
# dossier, or client IP. Analysts use RATE_LIMIT_ANALYST on every endpoint.
RATE_LIMIT_RESEARCH=40
RATE_LIMIT_DOC_SEARCH=40
RATE_LIMIT_SELF_SOURCE=40
RATE_LIMIT_UBO_DISCOVERY=20
RATE_LIMIT_GENERATE_POLICY=10
RATE_LIMIT_ANALYST=200

# benchmark/run.mjs only: the tenant's admin password, sent as a Bearer token.
BENCHMARK_ADMIN_TOKEN=your_tenant_admin_password_here

# Origins allowed to call the API from a browser (comma-separated, no trailing
# slash). The deployment's own Vercel URLs are always allowed, and localhost is
# allowed outside production, so this is only needed for a custom domain or an
# embedded surface. Empty is safe: same-origin requests need no CORS headers.
ALLOWED_ORIGINS=

# ── Clerk (staff login for the UBO surfaces) ────────────────────────────────
# Both are switches as well as credentials: with them unset, the login is off
# and the UBO screens and routes behave exactly as they did before Clerk.
# Set them together - a browser that signs people in while the API ignores the
# token is worse than neither.
#
# Publishable key: public by design, ships inside the browser bundle. The
# REACT_APP_ prefix is required or Create React App drops it at build time.
REACT_APP_CLERK_PUBLISHABLE_KEY=
# Secret key: server only. Never commit it, never put it in the client bundle.
CLERK_SECRET_KEY=
# Clerk user ids that are platform owners, comma-separated. The access list
# starts empty, so without this nobody - including you - can sign in to fill it.
# This setting also beats a stored row, so an owner cannot be locked out by a
# bad grant. Find an id in Clerk under Users -> the person -> User ID.
PLATFORM_OWNER_CLERK_IDS=
# Local development only: the UBO lab (public/ubo-lab.html) posts no tenant, so
# with Clerk switched off this names the tenant its research is filed under.
# Leave it empty anywhere real - absent, an unidentified caller is refused, and
# that refusal is what stops a missing Clerk key restoring the old "nium"
# default (UBO-1).
UBO_DEV_TENANT_ID=

# Which product this deployment is. "platform" (default) serves everything;
# "ubo" serves the ownership review module and refuses the rest, in the browser
# and on the server. Set BOTH, or the browser and the API disagree about what
# exists. The platform code is still in the bundle - unreachable, not absent.
PRODUCT_MODE=
REACT_APP_PRODUCT_MODE=

# Daily ceiling on provider calls per account, as a safety net rather than a
# working limit - set far above real use. Alerts fire at 60% and 85%, so an
# unusual day reaches a human before anything stops. Raisable without a deploy:
# a real customer hitting this on a busy day should be a one-minute change.
# Default 300.
SPEND_CAP_DAILY=
