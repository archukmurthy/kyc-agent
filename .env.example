# Copy this file to .env.local and fill in real values for local dev.
# Configure production values in Vercel only for the capabilities being deployed.

# Anthropic API key — used by api/research.js to proxy KYC research requests.
ANTHROPIC_API_KEY=sk-ant-...

# Optional Evidence Lab A3 semantic interpretation model. Both this and the
# Anthropic key above are required only for LIVE preserved-Artifact interpretation.
EVIDENCE_A3_ANTHROPIC_MODEL=claude-sonnet-4-5

# Admin password — fallback for the Nium tenant on /admin (and only Nium).
# All other tenants have per-tenant passwords managed by /super-admin and
# stored hashed in KV under tenant-auth:{tenantId}.
ADMIN_PASSWORD=nium-admin-2026

# Super admin password — gates the /super-admin tenant-management UI.
# Internal Nium use only; never given to clients.
SUPER_ADMIN_PASSWORD=nium-super-2026

# Tenant ID — keys this deployment's config in storage. Change per tenant when
# multi-tenant. Config is stored under config:{TENANT_ID}.
TENANT_ID=nium

# Dedicated Postgres database for the UBO POC. Apply additive migrations
# through db/migrations/021_ubo_poc_case_state.sql before deployment.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Durable ownership-document storage. Hosted POC deployments must use Blob;
# EVIDENCE_ARTIFACT_DIR is only an acceptable durable option on a persistent
# local/VM filesystem.
BLOB_READ_WRITE_TOKEN=
# EVIDENCE_ARTIFACT_DIR=C:/durable/ubo-poc-artifacts

# Live ownership research.
COMPANIES_HOUSE_API_KEY=
UBO_RESEARCH_ANTHROPIC_MODEL=claude-sonnet-4-5

# Immutable UBO POC release identity. Set both server and CRA build-time forms
# to the promoted tag/SHA; the REACT_APP values are embedded during the build.
UBO_POC_ENVIRONMENT=local
UBO_POC_PRODUCT_VERSION=development
UBO_POC_COMMIT_SHA=unversioned
UBO_POC_IDV_MODE=DEMO
REACT_APP_UBO_ENVIRONMENT=local
REACT_APP_UBO_PRODUCT_VERSION=development
REACT_APP_UBO_COMMIT_SHA=unversioned

# Internal health endpoint authentication. Use a dedicated random value in the
# hosted POC and send it only as x-internal-health-key.
UBO_POC_HEALTH_KEY=

# Vercel KV (or any Upstash Redis with the Vercel KV REST API) — when these
# are present the config API uses KV for storage and version snapshots.
# Without them the config API falls back to filesystem storage
# (./.config-store.json in dev, /tmp/config-store.json on Vercel).
KV_REST_API_URL=your_vercel_kv_url_here
KV_REST_API_TOKEN=your_vercel_kv_token_here
# Alternative durable cache connection when REST credentials are not used.
# REDIS_URL=rediss://user:password@host:6379
