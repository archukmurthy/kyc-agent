# Copy values into an ignored local environment file or deployment secret
# configuration. Never commit real credentials, tokens, or encryption keys.
IDV_RUNTIME_MODE=test
IDV_ENABLED_PROVIDERS=DIDIT,VERIFF
IDV_DEFAULT_PROVIDER=DIDIT
IDV_SYNTHETIC_ONLY=1

# Explicit POC-only tooling. Production rejects this flag.
IDV_POC_HARNESS_ENABLED=1
IDV_HARNESS_HOST=127.0.0.1
IDV_HARNESS_PORT=3100
IDV_HARNESS_ALLOW_REMOTE=0
IDV_HARNESS_TOKEN=replace-with-random-poc-access-secret

# Durable runtime (required for production and real-human POC).
IDV_DATABASE_URL=postgresql://replace-with-secret

# Trusted OIDC/JWT authentication. All claims must be issuer-signed.
IDV_OIDC_ISSUER=https://identity.example
IDV_OIDC_AUDIENCE=idv-api
IDV_OIDC_TENANT_CLAIM=tenant_id
IDV_OIDC_ROLES_CLAIM=roles
IDV_OIDC_SCOPES_CLAIM=scope
IDV_OIDC_ACCEPTED_ALGORITHMS=RS256

# Didit Full KYC workflow.
DIDIT_BASE_URL=https://verification.didit.me
DIDIT_ENVIRONMENT=sandbox
# Temporary non-production troubleshooting only. Production rejects this flag.
IDV_DEBUG_DIDIT_HTTP=0
DIDIT_API_KEY=replace-me
DIDIT_WORKFLOW_ID=replace-me
DIDIT_WEBHOOK_SECRET=replace-me
DIDIT_CALLBACK_URL=https://idv.example/provider-return?provider=DIDIT
DIDIT_PUBLIC_WEBHOOK_URL=https://idv.example/provider-webhooks/didit

# Veriff Essential / Full Auto comparison workflow.
VERIFF_BASE_URL=https://stationapi.veriff.com
VERIFF_API_KEY=replace-me
VERIFF_SHARED_SECRET=replace-me
VERIFF_WORKFLOW=ESSENTIAL_FULL_AUTO
VERIFF_CALLBACK_URL=https://idv.example/provider-return?provider=VERIFF
VERIFF_PUBLIC_WEBHOOK_URL=https://idv.example/provider-webhooks/veriff

# Versioned inputs. Estimates are never reported as confirmed actual cost.
IDV_ROUTING_OVERRIDES_JSON=[]
IDV_COST_CONFIG_JSON={}

# No environment-variable master-key setting exists by design. Production must
# inject an approved ManagedKeyProvider implementation backed by managed KMS.
