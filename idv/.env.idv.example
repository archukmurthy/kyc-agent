# Set these in the process environment or in an ignored local env file.
# Never commit real provider credentials.
IDV_ENVIRONMENT=sandbox
IDV_DEFAULT_PROVIDER=DIDIT
IDV_SYNTHETIC_ONLY=1
IDV_HARNESS_HOST=127.0.0.1
IDV_HARNESS_PORT=3100

DIDIT_API_KEY=replace-me
DIDIT_WORKFLOW_ID=replace-me
DIDIT_WEBHOOK_SECRET=replace-me
DIDIT_CALLBACK_URL=https://your-public-tunnel.example/return?provider=DIDIT

VERIFF_API_KEY=replace-me
VERIFF_SHARED_SECRET=replace-me
VERIFF_WORKFLOW=ESSENTIAL
VERIFF_CALLBACK_URL=https://your-public-tunnel.example/return?provider=VERIFF

# Optional JSON. Values shown are examples only, not vendor price claims.
IDV_ROUTING_OVERRIDES_JSON=[]
IDV_COST_CONFIG_JSON={}
